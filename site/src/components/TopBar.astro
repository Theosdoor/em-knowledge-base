---
import { getCollection } from 'astro:content'

interface Props {
  search?: boolean
}

const { search = false } = Astro.props
const base = import.meta.env.BASE_URL

const notes = await getCollection('notes')
const links = notes
  .map((note) => ({ href: `${base}notes/${note.id}/`, label: note.data.title ?? note.id }))
  .sort((a, b) => a.label.localeCompare(b.label))

const current = Astro.url.pathname
---

<header
  class="fixed inset-x-0 top-0 z-30 flex h-12 items-center gap-3 border-b px-3 sm:px-4"
  style="background: var(--panel); border-color: var(--rule)"
>
  {/* The favicon's own mark: what people see in the tab is what takes them home.
      Keep the geometry in step with public/favicon.svg. */}
  <a
    href={base}
    aria-label="Home — the graph"
    class="grid h-7 w-7 shrink-0 place-items-center rounded transition-opacity hover:opacity-80"
  >
    {/* Drawn larger than the neighbouring icons because the mark's own margin
        eats a third of its box. */}
    <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <g stroke="var(--muted)" stroke-width="1.5">
        <line x1="10" y1="11" x2="22" y2="9"></line>
        <line x1="10" y1="11" x2="14" y2="23"></line>
        <line x1="22" y1="9" x2="14" y2="23"></line>
      </g>
      <circle cx="10" cy="11" r="3.6" fill="var(--match-name)"></circle>
      <circle cx="22" cy="9" r="2.6" fill="var(--match-tag)"></circle>
      <circle cx="14" cy="23" r="2.6" fill="var(--match-tag)"></circle>
    </svg>
  </a>

  {
    search && (
      <div class="relative flex min-w-0 flex-1 items-center gap-3">
        <div class="search-shell relative w-full min-w-0 max-w-md">
          <input
            id="search"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search author, title, year or tag"
            aria-label="Search papers by author, title, year or tag"
            class="w-full rounded-md border bg-transparent py-1 pl-2.5 pr-8 text-[0.8125rem] outline-none placeholder:opacity-60"
            style="border-color: var(--rule); color: var(--bright)"
          />
          {/* Nobody finds a keyboard shortcut they were not told about. */}
          <kbd
            aria-hidden="true"
            class="search-hint pointer-events-none absolute right-2 top-1/2 grid h-4 w-4 -translate-y-1/2 place-items-center rounded border font-mono text-[0.625rem] transition-opacity"
            style="border-color: var(--rule); color: var(--muted)"
          >
            /
          </kbd>
        </div>
        {/* Live readout: every paper in this corpus reports rates, so the interface reports one too. */}
        <output
          id="readout"
          for="search"
          class="hidden shrink-0 font-mono text-[0.6875rem] tabular-nums sm:block"
          style="color: var(--muted)"
        />
      </div>
    )
  }

  <nav class="ml-auto flex shrink-0 items-center gap-1">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="hidden rounded px-2 py-1 text-[0.8125rem] transition-colors md:block"
          style={`color: ${current === link.href ? 'var(--bright)' : 'var(--muted)'}`}
        >
          {link.label}
        </a>
      ))
    }
    {
      [
        { href: `${base}tables/`, label: 'tables' },
        { href: `${base}papers/`, label: 'papers' },
        { href: `${base}tags/`, label: 'tags' },
      ].map((link) => (
        <a
          href={link.href}
          class="hidden rounded px-2 py-1 font-mono text-[0.8125rem] transition-colors md:block"
          style={`color: ${current === link.href ? 'var(--bright)' : 'var(--muted)'}`}
        >
          {link.label}
        </a>
      ))
    }

    {
      search && (
        <button
          id="mode-toggle"
          type="button"
          aria-label="Switch between 2D and 3D graph"
          class="hidden h-7 w-10 place-items-center rounded border font-mono text-[0.6875rem] transition-colors sm:grid"
          style="border-color: var(--rule); color: var(--muted)"
        >
          <span id="mode-label">2D</span>
        </button>
      )
    }

    {
      search && (
        <button
          id="heat-toggle"
          type="button"
          aria-pressed="true"
          title="Colour papers by how recent they are"
          class="hidden h-7 items-center gap-1.5 rounded border px-2 font-mono text-[0.6875rem] transition-colors sm:flex"
          style="border-color: var(--rule); color: var(--muted)"
        >
          <span
            class="h-2 w-6 rounded-sm"
            style="background: var(--heat-ramp)"
          />
          recency
        </button>
      )
    }

    <button
      id="theme-toggle"
      type="button"
      aria-label="Switch between light and dark"
      class="grid h-7 w-7 place-items-center rounded border text-[0.8125rem] transition-colors"
      style="border-color: var(--rule); color: var(--muted)"
    >
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 1.4V13.6a5.6 5.6 0 0 1 0-11.2Z"
          fill="currentColor"></path>
      </svg>
    </button>

    <a
      href="https://github.com/Theosdoor/em-knowledge-base"
      target="_blank"
      rel="noopener"
      aria-label="This vault on GitHub"
      title="This vault on GitHub"
      class="grid h-7 w-7 place-items-center rounded border transition-colors"
      style="border-color: var(--rule); color: var(--muted)"
    >
      <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
    </a>

    <button
      id="help-open"
      type="button"
      aria-label="How to use this site"
      class="grid h-7 w-7 place-items-center rounded border font-mono text-[0.8125rem] transition-colors"
      style="border-color: var(--rule); color: var(--muted)"
    >
      ?
    </button>
  </nav>
</header>

<style>
  /* The hint is an offer, not a label: it goes as soon as the field is in use. */
  .search-shell:focus-within .search-hint,
  .search-shell:has(#search:not(:placeholder-shown)) .search-hint {
    opacity: 0;
  }
</style>

<script>
  const root = document.documentElement

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = getComputedStyle(root).colorScheme !== 'light'
    const next = dark ? 'light' : 'dark'
    root.dataset.theme = next
    localStorage.setItem('theme', next)
  })

  const search = document.getElementById('search') as HTMLInputElement | null

  /** True while the keystroke belongs to whatever is being typed into. */
  function typing() {
    const el = document.activeElement
    return (
      el instanceof HTMLElement &&
      (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)
    )
  }

  document.addEventListener('keydown', (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return

    // `/` focuses search, the convention every researcher already has from
    // their reference manager.
    if (event.key === '/' && search && !typing()) {
      event.preventDefault()
      search.focus()
    }

    // `.` goes back to the graph. On a page that has one, the graph script
    // takes this instead and pulls the camera back out rather than reloading.
    if (event.key === '.' && !typing() && !document.getElementById('graph')) {
      event.preventDefault()
      location.href = root.dataset.base ?? '/'
    }

    if (event.key === 'Escape' && search && document.activeElement === search) {
      search.value = ''
      search.dispatchEvent(new Event('input', { bubbles: true }))
      search.blur()
    }
  })
</script>
