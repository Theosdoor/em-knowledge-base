---
import { formatDate, type GraphNode } from '../lib/graph-model'

interface Props {
  node: GraphNode
}

const { node } = Astro.props
const base = import.meta.env.BASE_URL

const meta = [node.id, formatDate(node.date), node.venue, node.category].filter(Boolean)

// An arXiv paper has two addresses worth offering; anything else has one.
const links =
  node.pdf && node.pdf !== node.url
    ? [
        { href: node.url, label: 'abs' },
        { href: node.pdf, label: 'pdf' },
      ].filter((link) => link.href)
    : node.url
      ? [{ href: node.url, label: 'paper' }]
      : []
---

<header class="mb-6">
  <p class="font-mono text-[0.6875rem]" style="color: var(--muted)">
    {meta.join(' · ')}
  </p>

  <h1 class="mt-2 text-xl font-semibold leading-tight" style="color: var(--bright)">
    {node.title}
  </h1>

  {
    node.authors.length > 0 && (
      <p class="mt-1.5 text-sm" style="color: var(--muted)">
        {node.authors.join(', ')}
      </p>
    )
  }

  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[0.6875rem]">
    <span style="color: var(--muted)">{node.degree} related</span>
    {
      links.map((link) => (
        <a href={link.href} rel="noopener" style="color: var(--match-tag)">
          {link.label} ↗
        </a>
      ))
    }
  </p>

  {
    node.tags.length > 0 && (
      <ul class="tag-row mt-3">
        {node.tags.map((tag) => (
          <li>
            <a href={`${base}tags/#${tag.replace(/\//g, '-')}`}>{tag}</a>
          </li>
        ))}
      </ul>
    )
  }
</header>
