---
import Base from './Base.astro'

interface Props {
  title: string
  eyebrow?: string
  description?: string
}

const { title, eyebrow, description } = Astro.props
---

<Base title={`${title} — Misalignment Empirics`} description={description}>
  <div class="h-full overflow-y-auto">
    <article class="note mx-auto w-full max-w-2xl px-5 py-10 sm:px-6">
      <header class="mb-8">
        {
          eyebrow && (
            <p
              class="font-mono text-[0.6875rem] uppercase tracking-[0.09em]"
              style="color: var(--muted)"
            >
              {eyebrow}
            </p>
          )
        }
        <h1 class="mt-2 text-2xl font-semibold leading-tight" style="color: var(--bright)">
          {title}
        </h1>
      </header>
      <slot />
    </article>
  </div>
</Base>
